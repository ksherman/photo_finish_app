{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoFinish",
  "version": "0.1.0",
  "identifier": "com.photofinish.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../crates/photofinish-core/src",
      "../crates/photofinish-core/Cargo.toml"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "PhotoFinish",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Photography",
    "shortDescription": "Local-network event photo ingest, LAN kiosk viewer, and instant USB fulfillment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
