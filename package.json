{
  "name": "photofinish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && pnpm run build:kiosk",
    "build:kiosk": "node -e \"require('fs').rmSync('crates/photofinish-core/kiosk-dist/assets', { recursive: true, force: true })\" && vite build --config vite.kiosk.config.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  }
}
